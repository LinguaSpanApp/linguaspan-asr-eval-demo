# Copy to .env and fill in ONE of these (x-api-key is simplest for a batch script).
LINGUASPAN_API_KEY=
LINGUASPAN_BEARER_TOKEN=

# Hugging Face fine-grained token (read-only, scoped to the dataset/model repos
# your ML lead shared). Standard var name -- huggingface_hub picks this up
# automatically, and our own dataset-download code will read it too.
HF_TOKEN=

# Optional overrides (defaults shown)
# LINGUASPAN_API_URL=https://mlapi.linguaspanapp.com
# LINGUASPAN_API_TIMEOUT=120
# LINGUASPAN_POLL_INTERVAL=2
# LINGUASPAN_POLL_TIMEOUT=300
